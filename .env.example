# Copy this file to .env and fill in values only after you are authorized to
# access the WUSA offers. Never commit .env or share its contents.

# Optional: a session cookie string. A private scraper/request.curl file also works.
WUSA_COOKIE=

# Optional: only used by the private Python classifier, never by the demo site.
GEMINI_API_KEY=

# Optional overrides.
# GEMINI_MODEL=gemini-3.5-flash-lite
# NOMINATIM_USER_AGENT=WusaRewardsMap/1.0 (contact: you@example.com)
