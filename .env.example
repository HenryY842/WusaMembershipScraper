# Copy this file to .env for your private local settings.
# The demo website works without either value.

# Optional: WUSA session cookies for authorized scraper access.
# Keep this blank in the public template. Put the raw Cookie header value
# in your private .env file, or use scraper/request.curl as described in README.md.
WUSA_COOKIE=

# Optional: used only when running Gemini classification.
GEMINI_API_KEY=
